local EggStealToggle = EggTab:Toggle({
    Title = "Auto Steal Best",
    Desc = "Steals best egg currently on the game",
    Icon = "mouse-pointer-click",
    Type = "Toggle",
    Value = autoStealEnabled,
    Callback = function(value)
        autoStealEnabled = value
        Memory.EggAutoStealEnabled = value

        -- Mutual exclusivity: Auto Steal Best and Big Only cannot both be on
        if value then
            if bigOnlyAutoStealEnabled then
                bigOnlyAutoStealEnabled = false
                Memory.EggBigOnly = false
                eggBigOnly = false
                bigOnlyLoopRunning = false
                pcall(function()
                    if EggBigOnlyToggle and EggBigOnlyToggle.Set then
                        EggBigOnlyToggle:Set(false)
                    elseif EggBigOnlyToggle and EggBigOnlyToggle.SetValue then
                        EggBigOnlyToggle:SetValue(false)
                    end
                end)
                cancelActiveTween()
                resetCarryDetection()
            end
        end

        if not autoStealEnabled then
            cancelActiveTween()
            currentStealState = StealState.IDLE
            targetEggUid = nil
            targetEggScore = nil
            collectionAttempts = 0
            resetCarryDetection()
            return
        end

        if autoLoopRunning then return end
        autoLoopRunning = true

        local targetEggScore = nil
        local collectionAttempts = 0
        local maxCollectionAttempts = 20
        local lastTargetSwitchTime = 0
        local targetSwitchCooldown = 0.5
        local lastPromptFire = 0
        local promptFireInterval = 0.08

        task.spawn(function()
            while autoStealEnabled do
                local waitTime = 0.03

                syncEggs()

                isCarryingEgg = checkCarryingEgg()

                if isAreaSealed() then
                    if currentStealState ~= StealState.WAITING_RESET then
                        currentStealState = StealState.WAITING_RESET
                        cancelActiveTween()
                    end
                    waitTime = 0.3
                elseif currentStealState == StealState.WAITING_RESET then
                    currentStealState = StealState.IDLE
                    waitTime = 0.5
                else
                    if isCarryingEgg then
                        if currentStealState ~= StealState.RETURNING and currentStealState ~= StealState.DEPOSITING then
                            currentStealState = StealState.RETURNING
                            tweenCharacterTo(getReturnPosition(), tweenSpeed)
                        end
                    end

                    refreshCarriedEggsCache()

                    if currentStealState == StealState.IDLE then
                        -- Skip if best egg is now carried by someone else
                        if bestEggUid and carriedEggsCache[bestEggUid] then
                            bestEggUid = nil
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                            cancelActiveTween()
                            waitTime = 0.1
                        elseif bestEggUid and trackedEggs[bestEggUid] then
                            local data = trackedEggs[bestEggUid]
                            local model = data.model
                            if model and model.Parent then
                                local bp = data.basePart or getModelBasePart(model)
                                data.basePart = bp
                                if bp then
                                    targetEggUid = bestEggUid
                                    targetEggScore = scoreEgg(data)
                                    collectionAttempts = 0
                                    currentStealState = StealState.MOVING_TO_EGG
                                    tweenCharacterTo(bp.Position, tweenSpeed)
                                end
                            end
                        else
                            waitTime = 0.2
                        end

                    elseif currentStealState == StealState.MOVING_TO_EGG then
                        if isCarryingEgg then
                            currentStealState = StealState.RETURNING
                            tweenCharacterTo(getReturnPosition(), tweenSpeed)
                        elseif not targetEggUid or not trackedEggs[targetEggUid] then
                            currentStealState = StealState.IDLE
                            cancelActiveTween()
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                        elseif carriedEggsCache[targetEggUid] then
                            -- Target egg got picked up by someone else, find new target
                            currentStealState = StealState.IDLE
                            cancelActiveTween()
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                            bestEggUid = nil
                            waitTime = 0.1
                        elseif bestEggUid and bestEggUid ~= targetEggUid and trackedEggs[bestEggUid] then
                            -- Check if new best egg is NOT carried by someone else
                            if not carriedEggsCache[bestEggUid] then
                                local newScore = scoreEgg(trackedEggs[bestEggUid])
                                local now = tick()
                                if (not targetEggScore or newScore > targetEggScore) and (now - lastTargetSwitchTime) > targetSwitchCooldown then
                                    lastTargetSwitchTime = now
                                    targetEggScore = newScore
                                    targetEggUid = bestEggUid
                                    local data = trackedEggs[bestEggUid]
                                    local bp = data.basePart or getModelBasePart(data.model)
                                    data.basePart = bp
                                    if bp then
                                        tweenCharacterTo(bp.Position, tweenSpeed)
                                    end
                                end
                            end
                        else
                            local data = trackedEggs[targetEggUid]
                            local bp = data.basePart
                            if bp and bp.Parent and isAtPosition(bp.Position, 8) then
                                cancelActiveTween()
                                collectionAttempts = 0
                                currentStealState = StealState.COLLECTING
                            end
                        end

                    elseif currentStealState == StealState.COLLECTING then
                        if isCarryingEgg then
                            collectionAttempts = 0
                            currentStealState = StealState.RETURNING
                            tweenCharacterTo(getReturnPosition(), tweenSpeed)
                        elseif not targetEggUid or not trackedEggs[targetEggUid] then
                            currentStealState = StealState.IDLE
                            cancelActiveTween()
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                        else
                            local data = trackedEggs[targetEggUid]
                            local model = data.model
                            local prompt = nil
                            local promptPos = nil

                            if model and model.Parent then
                                prompt = getModelPrompt(model)
                            end
                            if not prompt then
                                local bp = data.basePart or getModelBasePart(model)
                                if bp then
                                    prompt = findPromptNearPosition(bp.Position, 30)
                                    if prompt and prompt.Parent then
                                        promptPos = prompt.Parent.Position
                                    end
                                end
                            elseif prompt and prompt.Parent then
                                promptPos = prompt.Parent.Position
                            end

                            if prompt then
                                collectionAttempts = collectionAttempts + 1
                                if collectionAttempts <= maxCollectionAttempts then
                                    local char = LocalPlayer.Character
                                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                                    local canFire = true
                                    if hrp and promptPos then
                                        local dist = (hrp.Position - promptPos).Magnitude
                                        canFire = dist <= (prompt.MaxActivationDistance + 5)
                                    end

                                    if canFire then
                                        local now = tick()
                                        if now - lastPromptFire >= promptFireInterval then
                                            instantFirePrompt(prompt)
                                            lastPromptFire = now
                                        end
                                    end
                                    waitTime = 0.08
                                else
                                    currentStealState = StealState.IDLE
                                    cancelActiveTween()
                                    targetEggUid = nil
                                    targetEggScore = nil
                                    collectionAttempts = 0
                                end
                            else
                                currentStealState = StealState.IDLE
                                cancelActiveTween()
                                targetEggUid = nil
                                targetEggScore = nil
                                collectionAttempts = 0
                            end
                        end

                    elseif currentStealState == StealState.RETURNING then
                        if not isCarryingEgg then
                            cancelActiveTween()
                            currentStealState = StealState.IDLE
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                            resetCarryDetection()
                        elseif isAtPosition(getReturnPosition(), 12) then
                            cancelActiveTween()
                            currentStealState = StealState.DEPOSITING
                        end

                    elseif currentStealState == StealState.DEPOSITING then
                        if not isCarryingEgg then
                            currentStealState = StealState.IDLE
                            targetEggUid = nil
                            targetEggScore = nil
                            collectionAttempts = 0
                            resetCarryDetection()
                        end
                    end
                end

                task.wait(waitTime)
            end

            autoLoopRunning = false
            cancelActiveTween()
            currentStealState = StealState.IDLE
            targetEggUid = nil
            targetEggScore = nil
            collectionAttempts = 0
            resetCarryDetection()
        end)
    end,
})
