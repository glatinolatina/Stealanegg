local function createToggleSwitch(parent, initialState)
    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0, 48, 0, 26)
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -12, 0.5, 0)
    track.BackgroundColor3 = initialState and THEME.Success or Color3.fromRGB(55, 55, 65)
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = parent

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 20, 0, 20)
    thumb.Position = initialState and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.Parent = track

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb

    local thumbShadow = Instance.new("UIStroke")
    thumbShadow.Color = Color3.fromRGB(0, 0, 0)
    thumbShadow.Transparency = 0.7
    thumbShadow.Thickness = 1
    thumbShadow.Parent = thumb

    local state = initialState

    local function updateToggle(animated)
        local info = animated and TWEEN_SMOOTH or TWEEN_FAST
        if state then
            tween(track, { BackgroundColor3 = THEME.Success }, info)
            tween(thumb, { Position = UDim2.new(1, -23, 0.5, -10) }, info)
        else
            tween(track, { BackgroundColor3 = Color3.fromRGB(55, 55, 65) }, info)
            tween(thumb, { Position = UDim2.new(0, 3, 0.5, -10) }, info)
        end
    end

    track.MouseEnter:Connect(function()
        if state then
            tween(track, { BackgroundColor3 = Color3.fromRGB(100, 230, 140) }, TWEEN_FAST)
        else
            tween(track, { BackgroundColor3 = Color3.fromRGB(70, 70, 80) }, TWEEN_FAST)
        end
    end)
    track.MouseLeave:Connect(function()
        updateToggle(true)
    end)

    return track, function(newState)
        state = newState
        updateToggle(true)
    end, function() return state end
end

