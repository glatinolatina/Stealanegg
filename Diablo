local cloneref = cloneref or function(...)
    return ...
end

local lp = cloneref(game:GetService("Players").LocalPlayer)
local CurrentHumanoid = nil

local newindexhook
local indexhook

local function indexHookFunc(self, index)
    if SpeedEnabled and not checkcaller() and typeof(self) == "Instance" then
        if self:IsA("Humanoid") and self:IsDescendantOf(lp.Character) then
            if type(index) == "string" then
                local cleanindex = index:split("\0")[1]
                if cleanindex == "WalkSpeed" then
                    CurrentHumanoid = cloneref(self)
                    return 0
                end
            end
        end
    end
    return indexhook(self, index)
end

local function newIndexHookFunc(self, index, value)
    if SpeedEnabled and not checkcaller() and typeof(self) == "Instance" then
        if self:IsA("Humanoid") and self:IsDescendantOf(lp.Character) then
            if type(index) == "string" then
                local cleanindex = index:split("\0")[1]
                if cleanindex == "WalkSpeed" then
                    CurrentHumanoid = cloneref(self)
                    CurrentHumanoid.WalkSpeed = value
                    return
                end
            end
        end
    end
    return newindexhook(self, index, value)
end

indexhook = hookmetamethod(game, "__index", indexHookFunc)
newindexhook = hookmetamethod(game, "__newindex", newIndexHookFunc)

local originalIndex = indexhook
local originalNewIndex = newindexhook

-- Reapply: periodically disable and re-enable spoofer hooks to stay undetected
local function reapplySpoofer()
    pcall(function()
        hookmetamethod(game, "__index", originalIndex)
        hookmetamethod(game, "__newindex", originalNewIndex)
    end)
    task.wait(0.05)
    if SpeedEnabled then
        pcall(function()
            indexhook = hookmetamethod(game, "__index", indexHookFunc)
            newindexhook = hookmetamethod(game, "__newindex", newIndexHookFunc)
        end)
    end
end

task.spawn(function()
    while true do
        task.wait(5)
        if SpeedEnabled then
            reapplySpoofer()
        end
    end
end)

